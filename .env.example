# Copier en .env et compléter. Ce fichier-ci est un modèle : il ne contient
# aucune valeur réelle et peut rester dans le dépôt.

# --- Base de données (obligatoire) -----------------------------------------
# MySQL / MariaDB. Sur o2switch, cPanel préfixe le nom de la base et celui de
# l'utilisateur par votre identifiant de compte (ex. abcd1234_growsavoir).
# connection_limit : un mutualisé plafonne les connexions simultanées ; la
# valeur par défaut de Prisma (processeurs × 2 + 1) est trop élevée pour ce
# contexte.
DATABASE_URL="mysql://abcd1234_growsavoir:motdepasse@localhost:3306/abcd1234_growsavoir?connection_limit=5"

# --- Adresse publique (obligatoire en production) --------------------------
# Sert aux URL canoniques, au sitemap et aux données structurées. Sans barre
# oblique finale.
SITE_URL="https://growsavoir.com"

# --- Premier compte administrateur -----------------------------------------
# Lus uniquement par le seed (npm run db:seed). À retirer une fois le compte
# créé ; le mot de passe se change ensuite depuis la console.
ADMIN_EMAIL="admin@growsavoir.com"
ADMIN_PASSWORD=""

# --- Mentions légales -------------------------------------------------------
# Obligatoires en France pour un site accessible au public. Tant qu'un champ
# est vide, la page /mentions-legales l'affiche comme « à compléter ».
LEGAL_PUBLISHER=""
LEGAL_STATUS=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_REGISTRATION=""
LEGAL_EDITOR=""
LEGAL_HOST=""
LEGAL_HOST_ADDRESS=""

# Durée de conservation des messages du formulaire de contact, en jours.
# Cette valeur est annoncée dans la politique de confidentialité et appliquée
# par la purge (scripts/purge.ts et l'ouverture de la boîte de réception).
LEGAL_MESSAGE_RETENTION_DAYS="365"
