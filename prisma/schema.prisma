// Modèle de données GrowSavoir — variante MySQL / MariaDB.
//
// Cette branche vise un hébergement mutualisé o2switch. Leur PostgreSQL est en
// 9.6 et ils annoncent eux-mêmes qu'ils cesseront probablement de le proposer ;
// MariaDB, en revanche, y est pleinement supporté. L'URL se règle par la seule
// variable DATABASE_URL. Voir docs/o2switch.md pour la mise en production.
//
// Les types @db.Text et @db.LongText ne sont pas décoratifs : sur MySQL, Prisma
// traduit un `String` par VARCHAR(191), alors que le corps d'une leçon fait
// plusieurs milliers de caractères (4 259 pour la plus longue aujourd'hui).
// Sans ces annotations, l'insertion échoue.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// Une matière du catalogue : Langue Arabe, Fiqh, Mathématiques…
model Subject {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("") @db.Text
  /// Emoji ou nom d'icône affiché sur la carte du catalogue.
  icon        String   @default("📘")
  /// Teinte de la matière, en hexadécimal, pour les cartes et les bandeaux.
  color       String   @default("#4f46e5")
  position    Int      @default(0)
  published   Boolean  @default(true)
  lessons     Lesson[]
  activities  Activity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Une leçon. `body` et `assessment` restent du JSON : la structure
/// pédagogique (sections, quiz) évolue plus vite qu'un schéma relationnel,
/// et l'éditeur de la console écrit ces champs directement.
model Lesson {
  id                String   @id @default(cuid())
  slug              String   @unique
  title             String
  summary           String   @default("") @db.Text
  level             String   @default("n1-fondamentaux")
  ageGroup          String   @default("6-8 ans")
  estimatedMinutes  Int      @default(20)
  position          Int      @default(0)
  published         Boolean  @default(true)
  /// Réservée aux comptes connectés.
  locked            Boolean  @default(false)
  learningObjectives String  @default("[]") @db.Text
  keywords          String   @default("[]") @db.Text
  sources           String   @default("[]") @db.Text
  prerequisites     String   @default("[]") @db.Text
  /// LongText plutôt que Text : la console n'impose aucune limite de taille à
  /// une leçon, et une leçon très fournie dépasserait les 64 Ko d'un TEXT.
  body              String   @default("{}") @db.LongText
  assessment        String   @default("{}") @db.LongText
  author            String   @default("GrowSavoir")
  subject           Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId         String
  progress          Progress[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([subjectId, position])
}

/// Un compte. `role` vaut "admin", "teacher" ou "student".
model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String     @default("")
  role         String     @default("student")
  passwordHash String
  passwordSalt String
  active       Boolean    @default(true)
  sessions     Session[]
  progress     Progress[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Session ouverte, conservée en base pour survivre aux redémarrages et
/// pour qu'une révocation soit immédiate.
model Session {
  id        String   @id
  csrf      String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Avancement d'un élève sur une leçon.
model Progress {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  completed   Boolean  @default(false)
  quizScore   Int?
  completedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
}

/// Interrupteur de fonctionnalité, pilotable depuis la console : c'est ce qui
/// permet d'« ajouter des fonctionnalités » sans redéployer.
model Feature {
  key         String   @id
  label       String
  description String   @default("") @db.Text
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Un message envoyé par le formulaire de contact. Conservé en base plutôt
/// qu'expédié par un service tiers : la console le montre, et rien ne dépend
/// d'un fournisseur d'e-mail configuré ailleurs.
model Message {
  id        String   @id @default(cuid())
  name      String
  /// Non indexée : elle peut donc dépasser les 191 caractères d'un VARCHAR par
  /// défaut sans poser de problème de longueur de clé.
  email     String   @db.VarChar(255)
  subject   String   @default("") @db.Text
  body      String   @db.Text
  /// Marqué au lieu d'être jeté : un filtre anti-robot ne doit pas perdre le
  /// message d'une vraie personne.
  suspect   Boolean  @default(false)
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([handled, createdAt])
}

/// Une activité à faire : matériel, étapes, critères d'observation. Reprise du
/// site précédent, où ces 43 fiches existaient déjà — les perdre dans la
/// refonte aurait été le plus coûteux des choix.
model Activity {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  description        String   @default("") @db.Text
  /// Durée annoncée, telle qu'elle est écrite : « 20 min », « 1 h ».
  duration           String   @default("")
  /// beginner | intermediate | advanced | expert
  difficulty         String   @default("beginner")
  /// Tranche d'âge visée : les activités vont au-delà des 6-8 ans des leçons.
  ageGroup           String   @default("6-8")
  materials          String   @default("[]") @db.Text
  instructions       String   @default("[]") @db.Text
  learningObjectives String   @default("[]") @db.Text
  tips               String   @default("[]") @db.Text
  assessment         String   @default("[]") @db.Text
  interactive        Boolean  @default(true)
  alone              Boolean  @default(false)
  supervised         Boolean  @default(false)
  position           Int      @default(0)
  published          Boolean  @default(true)
  subject            Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  subjectId          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([subjectId, position])
}
