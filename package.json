{
  "name": "growsavoir",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme éducative GrowSavoir — rendu serveur, console d'administration, contenu et utilisateurs gérables.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "passe": "node --experimental-strip-types scripts/set-password.ts",
    "purge": "node --experimental-strip-types scripts/purge.ts",
    "db:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "marked": "^15.0.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "prisma": "^6.1.0",
    "typescript": "^5.7.0",
    "@types/react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
