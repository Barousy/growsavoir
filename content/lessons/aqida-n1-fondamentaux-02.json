    "introduction": {
      "title": "Allah a de beaux Noms",
      "content": "Exemples : **ar-Raḥmân** (Le Tout-Miséricordieux), **ar-Raḥîm** (Le Très-Miséricordieux), **al-Khâliq** (Le Créateur), **as-Samî‘** (Il entend tout), **al-Baṣîr** (Il voit tout)."
    },
    "mainContent": [
      {
        "type": "example",
        "title": "Cartes Nom → sens",
        "content": "al-Khâliq → Créateur ; as-Samî‘ → Il **entend** ; al-Baṣîr → Il **voit**."
      },
      {
        "type": "activity",
        "title": "Invocation courte",
        "content": "Dis : « **Yâ Raḥmân**, aide-moi à être gentil. »"
      },
      {
        "type": "exercise",
        "title": "Je relie",
        "content": "Entendre → **as-Samî‘** ; Voir → **al-Baṣîr** ; Miséricordieux → **ar-Raḥmân/ar-Raḥîm**."
      },
      {
        "type": "summary",
        "title": "Récap",
