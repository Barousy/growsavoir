    "introduction": {
      "title": "Pourquoi des accents ?",
      "content": "Les **accents** aident à **prononcer** et parfois **différencier** des mots : **é/è/ê** ; la **cédille** (ç) donne le son [s]."
    },
    "mainContent": [
      {
        "type": "example",
        "title": "Mots modèles",
        "content": "**été, père, tête, garçon, maïs, Noël**.",
        "examples": [
          {
            "code": "tête / été / garçon",
            "title": "Accents & cédille",
            "description": "é/è/ê/ç",
            "explanation": "Repérage visuel"
          }
        ]
      },
      {
        "type": "activity",
        "title": "Je place le bon accent",
        "content": "Complète : t__te (tête), p__re (père), __té (été)."
      },
      {
        "type": "exercise",
        "title": "Dictée flash",
        "content": "Écris : **tête, été, garçon, Noël, maïs**."
      },
      {
        "type": "summary",
        "title": "Récap",
        "content": "é aigu, è grave, ê circonflexe ; ç pour [s]."
      }
